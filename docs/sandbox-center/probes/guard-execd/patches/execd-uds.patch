+package listener
+
+import (
+	"context"
+	"errors"
+	"io"
+	"net"
+	"net/http"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"runtime"
+	"syscall"
+	"testing"
+	"time"
+)
+
+func TestListenRejectsInvalidPaths(t *testing.T) {
+	for _, path := range []string{"relative.sock", "/", "/tmp/../control.sock", "/tmp//control.sock", "/tmp/control.sock/"} {
+		t.Run(path, func(t *testing.T) {
+			l, err := Listen(0, path)
+			if err == nil {
+				_ = l.Close()
+				t.Fatalf("accepted invalid path %q", path)
+			}
+		})
+	}
+}
+
+func TestListenRejectsUntrustedParent(t *testing.T) {
+	dir := t.TempDir()
+	if os.Geteuid() == 0 {
+		if err := os.Chmod(dir, 0755); err != nil {
+			t.Fatal(err)
+		}
+	}
+	path := filepath.Join(dir, "control.sock")
+	if l, err := Listen(0, path); err == nil {
+		_ = l.Close()
+		t.Fatal("accepted non-root-owned or non-private parent")
+	}
+	if _, err := os.Lstat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("failed listener created a path: %v", err)
+	}
+}
+
+func trustedDir(t *testing.T) string {
+	t.Helper()
+	if os.Geteuid() != 0 {
+		t.Skip("requires root to validate the privileged socket boundary")
+	}
+	root := "/tmp"
+	if runtime.GOOS == "darwin" {
+		root = "/private/tmp"
+	}
+	dir, err := os.MkdirTemp(root, "execd-listener-")
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = os.RemoveAll(dir) })
+	return dir
+}
+
+func TestUnixHTTPAndCleanup(t *testing.T) {
+	path := filepath.Join(trustedDir(t), "control.sock")
+	l, err := Listen(-1, path) // An invalid TCP port is irrelevant in Unix mode.
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = l.Close() })
+	info, err := os.Lstat(path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if info.Mode().Perm() != 0600 || info.Mode()&os.ModeSocket == 0 {
+		t.Fatalf("socket mode: %v", info.Mode())
+	}
+	server := &http.Server{Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		_, _ = io.WriteString(w, "private API")
+	})}
+	done := make(chan error, 1)
+	go func() { done <- server.Serve(l) }()
+	t.Cleanup(func() { _ = server.Close() })
+	transport := &http.Transport{DialContext: func(ctx context.Context, _, _ string) (net.Conn, error) {
+		return (&net.Dialer{}).DialContext(ctx, "unix", path)
+	}}
+	defer transport.CloseIdleConnections()
+	client := &http.Client{Transport: transport, Timeout: 2 * time.Second}
+	response, err := client.Get("http://execd/ping")
+	if err != nil {
+		t.Fatal(err)
+	}
+	body, err := io.ReadAll(response.Body)
+	_ = response.Body.Close()
+	if err != nil || response.StatusCode != http.StatusOK || string(body) != "private API" {
+		t.Fatalf("response = %q, %v", body, err)
+	}
+	if err := server.Close(); err != nil {
+		t.Fatal(err)
+	}
+	if err := <-done; !errors.Is(err, http.ErrServerClosed) {
+		t.Fatal(err)
+	}
+	if _, err := os.Lstat(path); !errors.Is(err, os.ErrNotExist) {
+		t.Fatalf("socket not removed on close: %v", err)
+	}
+}
+
+func TestExistingPathIsNeverRemoved(t *testing.T) {
+	dir := trustedDir(t)
+	for _, kind := range []string{"file", "symlink", "socket", "stale_socket"} {
+		t.Run(kind, func(t *testing.T) {
+			path := filepath.Join(dir, kind)
+			switch kind {
+			case "file":
+				if err := os.WriteFile(path, []byte("keep"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			case "symlink":
+				if err := os.Symlink("missing", path); err != nil {
+					t.Fatal(err)
+				}
+			case "socket", "stale_socket":
+				l, err := net.ListenUnix("unix", &net.UnixAddr{Name: path, Net: "unix"})
+				if err != nil {
+					t.Fatal(err)
+				}
+				defer l.Close()
+				if kind == "stale_socket" {
+					l.SetUnlinkOnClose(false)
+					if err := l.Close(); err != nil {
+						t.Fatal(err)
+					}
+				}
+			}
+			before, err := os.Lstat(path)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if l, err := Listen(0, path); err == nil {
+				_ = l.Close()
+				t.Fatal("accepted existing path")
+			}
+			after, err := os.Lstat(path)
+			if err != nil || !os.SameFile(before, after) {
+				t.Fatalf("existing path was changed: %v", err)
+			}
+		})
+	}
+}
+
+func TestRejectsSymlinkAndWritableAncestors(t *testing.T) {
+	dir := trustedDir(t)
+	real := filepath.Join(dir, "real")
+	if err := os.Mkdir(real, 0700); err != nil {
+		t.Fatal(err)
+	}
+	link := filepath.Join(dir, "link")
+	if err := os.Symlink(real, link); err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{filepath.Join(link, "control.sock"), filepath.Join(link, "child", "control.sock")} {
+		if err := os.MkdirAll(filepath.Dir(path), 0700); err != nil {
+			t.Fatal(err)
+		}
+		if l, err := Listen(0, path); err == nil {
+			_ = l.Close()
+			t.Fatalf("accepted symlink ancestor: %s", path)
+		}
+	}
+	if err := os.Chmod(dir, 0777); err != nil {
+		t.Fatal(err)
+	}
+	if l, err := Listen(0, filepath.Join(real, "control.sock")); err == nil {
+		_ = l.Close()
+		t.Fatal("accepted writable non-sticky ancestor")
+	}
+}
+
+func TestClosePreservesReplacement(t *testing.T) {
+	path := filepath.Join(trustedDir(t), "control.sock")
+	l, err := Listen(0, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	if err := os.Remove(path); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(path, []byte("replacement"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := l.Close(); err != nil {
+		t.Fatal(err)
+	}
+	body, err := os.ReadFile(path)
+	if err != nil || string(body) != "replacement" {
+		t.Fatalf("replacement lost: %q %v", body, err)
+	}
+}
+
+func TestUnprivilegedConnectDenied(t *testing.T) {
+	if path := os.Getenv("EXECD_TEST_UNIX_DIAL"); path != "" {
+		conn, err := net.DialTimeout("unix", path, time.Second)
+		if conn != nil {
+			_ = conn.Close()
+		}
+		if !errors.Is(err, os.ErrPermission) {
+			t.Fatalf("expected permission denied, got %v", err)
+		}
+		return
+	}
+	dir := trustedDir(t)
+	path := filepath.Join(dir, "control.sock")
+	l, err := Listen(0, path)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer l.Close()
+	// Copy the test executable into a traversable directory so the child can
+	// reach the actual dial check after dropping its identity.
+	public := trustedDir(t)
+	if err := os.Chmod(public, 0755); err != nil {
+		t.Fatal(err)
+	}
+	executable, err := os.Executable()
+	if err != nil {
+		t.Fatal(err)
+	}
+	binary, err := os.ReadFile(executable)
+	if err != nil {
+		t.Fatal(err)
+	}
+	helper := filepath.Join(public, "dial-test")
+	if err := os.WriteFile(helper, binary, 0755); err != nil {
+		t.Fatal(err)
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+	defer cancel()
+	cmd := exec.CommandContext(ctx, helper, "-test.run=^TestUnprivilegedConnectDenied$")
+	cmd.Env = append(os.Environ(), "EXECD_TEST_UNIX_DIAL="+path)
+	cmd.SysProcAttr = &syscall.SysProcAttr{Credential: &syscall.Credential{Uid: 65534, Gid: 65534, Groups: []uint32{}}}
+	if output, err := cmd.CombinedOutput(); err != nil {
+		t.Fatalf("unprivileged dial: %v: %s", err, output)
+	}
+}
+
+func TestRejectsNonRootOwnedDirectory(t *testing.T) {
+	dir := trustedDir(t)
+	if err := os.Chown(dir, 65534, 65534); err != nil {
+		t.Fatal(err)
+	}
+	if l, err := Listen(0, filepath.Join(dir, "control.sock")); err == nil {
+		_ = l.Close()
+		t.Fatal("accepted directory owned by workload identity")
+	}
+}
