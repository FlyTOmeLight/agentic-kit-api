+// Package listener owns the execd API transport.
+package listener
+
+import (
+	"fmt"
+	"net"
+)
+
+// Listen starts exactly one API listener. Unix mode requires a root-owned,
+// private parent directory, which the caller must provision before startup.
+// No existing path is removed, including a stale socket from a prior process.
+func Listen(port int, socketPath string) (net.Listener, error) {
+	if socketPath != "" {
+		return listenUnix(socketPath)
+	}
+	return net.Listen("tcp4", fmt.Sprintf(":%d", port))
+}
