+// distributed under the License is distributed on an "AS IS" BASIS,
+// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+// See the License for the specific language governing permissions and
+// limitations under the License.
+
+package listener
+
+import (
+	"errors"
+	"fmt"
+	"net"
+	"os"
+	"path/filepath"
+	"sync"
+	"syscall"
+)
+
+// listenUnix creates the protected control-plane socket.
+func listenUnix(socketPath string) (net.Listener, error) {
+	if !filepath.IsAbs(socketPath) || filepath.Clean(socketPath) != socketPath || socketPath == "/" {
+		return nil, fmt.Errorf("unix socket path must be absolute and clean: %q", socketPath)
+	}
+	if err := validateParent(filepath.Dir(socketPath)); err != nil {
+		return nil, err
+	}
+	if os.Geteuid() != 0 {
+		return nil, errors.New("unix socket listener must run as root")
+	}
+	if _, err := os.Lstat(socketPath); !errors.Is(err, os.ErrNotExist) {
+		if err == nil {
+			return nil, fmt.Errorf("unix socket path already exists: %s", socketPath)
+		}
+		return nil, fmt.Errorf("inspect unix socket path: %w", err)
+	}
+	conn, err := net.ListenUnix("unix", &net.UnixAddr{Name: socketPath, Net: "unix"})
+	if err != nil {
+		return nil, fmt.Errorf("listen on unix socket: %w", err)
+	}
+	// The standard listener unlinks by pathname. Keep a replacement file safe
+	// when closing, including repeated Close calls from http.Server.
+	conn.SetUnlinkOnClose(false)
+	info, err := os.Lstat(socketPath)
+	if err != nil {
+		_ = conn.Close()
+		return nil, fmt.Errorf("inspect created unix socket: %w", err)
+	}
+	owned := &unixListener{UnixListener: conn, path: socketPath, info: info}
+	if err := os.Chmod(socketPath, 0600); err != nil {
+		_ = owned.Close()
+		return nil, fmt.Errorf("protect unix socket: %w", err)
+	}
+	return owned, nil
+}
+
+func validateParent(parent string) error {
+	for dir := parent; ; dir = filepath.Dir(dir) {
+		info, err := os.Lstat(dir)
+		if err != nil {
+			return fmt.Errorf("inspect unix socket directory %s: %w", dir, err)
+		}
+		stat, ok := info.Sys().(*syscall.Stat_t)
+		if !info.IsDir() || info.Mode()&os.ModeSymlink != 0 || !ok || stat.Uid != 0 {
+			return fmt.Errorf("unix socket directory must be a root-owned directory without symlinks: %s", dir)
+		}
+		if dir == parent {
+			if info.Mode().Perm()&0077 != 0 {
+				return fmt.Errorf("unix socket parent must deny group and other access: %s", dir)
+			}
+		} else if info.Mode().Perm()&0022 != 0 && info.Mode()&os.ModeSticky == 0 {
+			return fmt.Errorf("unix socket ancestor is writable by non-root users: %s", dir)
+		}
+		// Root-owned sticky ancestors (e.g. /tmp) cannot rename or remove
+		// their root-owned children. Every intervening component is checked.
+		if dir == "/" {
+			return nil
+		}
+	}
+}
+
+type unixListener struct {
+	*net.UnixListener
+	path     string
+	info     os.FileInfo
+	once     sync.Once
+	closeErr error
+}
+
+func (l *unixListener) Close() error {
+	l.once.Do(func() {
+		l.closeErr = l.UnixListener.Close()
+		info, err := os.Lstat(l.path)
+		if errors.Is(err, os.ErrNotExist) {
+			return
+		}
+		if err != nil {
+			l.closeErr = errors.Join(l.closeErr, err)
+			return
+		}
+		if os.SameFile(l.info, info) {
+			l.closeErr = errors.Join(l.closeErr, os.Remove(l.path))
+		}
+	})
+	return l.closeErr
+}
